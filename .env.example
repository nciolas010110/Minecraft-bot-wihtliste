# Discord-Bot Token
DISCORD_TOKEN=DeinDiscordBotToken
CLIENT_ID=DeineBotClientID
# Optional: Für schnellen Slash-Command-Refresh im Testserver
GUILD_ID=DeineTestGuildID

# RCON-Verbindung zum Minecraft-Server
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=DeinRconPasswort

# Optional: Monitoring für Server-Status
# MONITOR_CHANNEL_ID legt den Discord-Kanal fest, in den Warnungen gesendet werden.
# MONITOR_INTERVAL_SECONDS legt das Abfrageintervall in Sekunden fest.
# MONITOR_RAM_THRESHOLD ist der RAM-%-Schwellenwert für eine Warnung.
# MONITOR_TPS_THRESHOLD ist die TPS-Schwelle für eine Warnung.
MONITOR_CHANNEL_ID=1535432171035041864
MONITOR_INTERVAL_SECONDS=60
MONITOR_RAM_THRESHOLD=80
MONITOR_TPS_THRESHOLD=16
